# Copier en .env.local et remplir les valeurs. Toutes les variables
# sont optionnelles : si une variable est vide, l'intégration
# correspondante est désactivée (fail silently, pas de crash).

# ─── Tracking & Analytics ────────────────────────────────────
NEXT_PUBLIC_GTM_ID=GTM-5DVWQ5QH
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
NEXT_PUBLIC_LINKEDIN_CONVERSION_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ─── CRM principal (GoHighLevel) ─────────────────────────────
# URL du webhook GHL (Sub-Account → Settings → Workflows → Webhook trigger)
GHL_WEBHOOK_URL=

# ─── Email backup / notification interne ────────────────────
# Resend envoie UNIQUEMENT la notif interne à NOTIFICATION_EMAIL.
# L'email de bienvenue au prospect est géré par GHL (workflow).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
NOTIFICATION_EMAIL=kostgroupe@gmail.com

# ─── Site ────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://dgr.kostacademy.com
