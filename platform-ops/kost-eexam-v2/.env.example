# Copier en .env.local (gitignored) pour le développement local.
# En production : injecté via docker-compose env_file, jamais commité.

# Secret de session iron-session — minimum 32 caractères aléatoires.
SESSION_SECRET=

# Chemin du fichier de base SQLite (WAL mode).
DB_PATH=./data/kost-eexam-v2.db

# Répertoire des sauvegardes (copies + journal backup-log.jsonl).
BACKUP_DIR=./data/backups

NODE_ENV=development

# Jeton partagé pour POST /api/attempts/sweep (appelé par cron externe en
# production — voir deploy/crontab.example). Non requis en dev.
SWEEP_TOKEN=

# Ne définir que pour les tests locaux servant un build de prod en clair
# (HTTP) — voir lib/session.ts. NE JAMAIS définir en déploiement réel.
# COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Email transactionnel (Resend) — voir docs/KOST_EEXAM_V2_RESEND_OPERATIONS.md
# ---------------------------------------------------------------------------

# Clé API Resend — SECRET, jamais commité, jamais journalisé, jamais
# NEXT_PUBLIC_*. Sans elle, EMAIL_MODE=log reste utilisable (aucun envoi
# réel), tout le reste du pipeline (rendu, outbox, préférences, RBAC) reste
# fonctionnel et testable.
RESEND_API_KEY=

# Secret de vérification de signature du webhook Resend (format whsec_...).
# SECRET, jamais commité. Sans lui, l'endpoint /api/webhooks/resend refuse
# toute requête (503) plutôt que de faire confiance à une requête non signée.
RESEND_WEBHOOK_SECRET=

# log (défaut, aucun envoi réel — juste écriture dans notification_log) |
# allowlist (envoi réel uniquement vers EMAIL_ALLOWED_RECIPIENTS — mode par
# défaut recommandé en staging) | send (envoi réel à tout destinataire —
# réservé à la production).
EMAIL_MODE=log

# Liste blanche (séparée par des virgules) utilisée uniquement quand
# EMAIL_MODE=allowlist. Toute autre adresse est marquée SUPPRESSED en base
# sans jamais toucher le réseau.
EMAIL_ALLOWED_RECIPIENTS=

# Identités d'expéditeur — jamais codées en dur dans le code métier.
EMAIL_FROM_EXAM="KOST E-EXAM <exam@kostacademy.com>"
EMAIL_FROM_NOTIFICATIONS="KOST Academy <notifications@kostacademy.com>"
EMAIL_FROM_SECURITY="KOST Academy Sécurité <security@kostacademy.com>"
EMAIL_FROM_SUPPORT="KOST Academy Support <support@kostacademy.com>"
# Adresse Reply-To réelle ET adresse "Besoin d'aide ?" affichée dans le pied
# de chaque email (lib/email/config.ts::getSupportEmail(), mission
# "COMPLETE USER MANAGEMENT" 2026-08-29 §33-35) — cbta@kostacademy.com est
# l'adresse externe confirmée/surveillée par le propriétaire, jamais
# support@kostacademy.com (alias générique non confirmé). Variable dédiée
# optionnelle si une adresse distincte du Reply-To est un jour nécessaire :
# EMAIL_SUPPORT_ADDRESS=cbta@kostacademy.com
EMAIL_REPLY_TO=cbta@kostacademy.com

# Fuseau horaire par défaut pour le formatage des dates dans les emails.
EMAIL_DEFAULT_TIMEZONE=Africa/Algiers

# Base URL publique de l'app (liens d'activation, de réinitialisation, etc.)
# — jamais déduite d'un en-tête de requête pour un lien envoyé par email.
APP_BASE_URL=https://staging.kostacademy.com
