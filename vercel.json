{
  "crons": [
    { "path": "/api/agent/run", "schedule": "0 7 * * 1-5" },
    { "path": "/api/agent/followup", "schedule": "0 8 * * 1-5" },
    { "path": "/api/agent/intel", "schedule": "0 6 * * 1-5" },
    { "path": "/api/prospects/scan", "schedule": "0 9 * * 1" },
